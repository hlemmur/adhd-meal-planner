# Copy to .env; never commit populated env files. Empty values need real credentials.
# Public/non-secret unless marked SECRET. No runtime mock mode.
# Variables for future integrations are listed now as required by CAR-151;
# health and deterministic tests require NONE of them.

# Platform config: local URL from `npm run supabase -- status` or hosted Settings > API.
# Consumed by webhook/planning/scheduler. Supabase injects these in Edge Functions.
# Do NOT send SUPABASE_* via custom `secrets set` commands (reserved prefix).
SUPABASE_URL=http://127.0.0.1:54321
# SECRET: local status output or hosted API settings; privileged, server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET: from Telegram @BotFather. Used by webhook/scheduler/registration tooling.
TELEGRAM_BOT_TOKEN=
# SECRET: independently generated token; used by webhook + registration.
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS URL; required for registration, not for localhost smoke tests.
TELEGRAM_WEBHOOK_URL=

# SECRET: from Google AI Studio, free-quota project. Planning + explicit live evals.
GEMINI_API_KEY=
# Non-secret: explicit stable Flash model ID verified to have free project quota.
# Deliberately blank: do not guess availability or use a floating *-latest alias.
GEMINI_MODEL=

# SECRET: generate separately from TELEGRAM_WEBHOOK_SECRET. Scheduler/consumers.
# Save the same value in Vault for authenticated Cron invocations when implemented.
INTERNAL_JOB_SECRET=
# Non-secret defaults; saved user timezone overrides the onboarding default.
DEFAULT_TIMEZONE=Europe/Stockholm
LOG_LEVEL=info

# TOOLING ONLY: not needed for tests/local health. No hosted commands run implicitly.
# Non-secret: hosted dashboard project reference; deploy command.
SUPABASE_PROJECT_REF=
# SECRET: personal access token from Supabase account settings; CLI deployment.
SUPABASE_ACCESS_TOKEN=
# SECRET: project DB password, only for hosted DB operations that need it.
SUPABASE_DB_PASSWORD=
# SECRET: direct/pooler connection string from Connect; export/restore/SQL tooling.
DATABASE_URL=

# Non-secret suggested bounds for the FUTURE explicit live eval runner (CAR-168).
# They do not trigger model calls; task #0 does not implement live evals.
EVAL_MAX_MODEL_CALLS=20
EVAL_CONCURRENCY=1
