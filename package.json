{
  "name": "adhd-meal-planner",
  "version": "0.1.0",
  "private": true,
  "description": "ADHD-aware Telegram meal planner — Supabase Edge Functions foundation",
  "engines": { "node": ">=22" },
  "scripts": {
    "format": "deno fmt",
    "format:check": "deno fmt --check",
    "lint": "deno lint",
    "typecheck": "deno check supabase/functions/health/index.ts scripts/*.ts tests/*.ts",
    "test": "deno test tests/",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "config:check": "deno run --allow-env --env-file=.env scripts/check-config.ts",
    "supabase": "supabase",
    "local:start": "supabase start --exclude postgres-meta",
    "local:stop": "supabase stop",
    "local:serve": "supabase functions serve health",
    "smoke:local": "deno run --allow-net=127.0.0.1:54321 scripts/smoke-local.ts"
  },
  "devDependencies": { "deno": "2.9.6", "supabase": "3.0.0" }
}
